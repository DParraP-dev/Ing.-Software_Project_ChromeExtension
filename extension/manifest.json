{
    "manifest_version": 3,
    "name": "FillPro",
    "description": "Autocompleta formularios de postulación (LinkedIn, Computrabajo, elempleo, Indeed, ATS) con los datos guardados en FillPro.",
    "version": "0.2.0",
    "permissions": [
        "storage",
        "activeTab"
    ],
    "host_permissions": [
        "http://localhost:3000/*"
    ],
    "action": {
        "default_title": "FillPro",
        "default_popup": "popup/popup.html"
    },
    "content_scripts": [
        {
            "matches": [
                "http://*/*",
                "https://*/*"
            ],
            "js": [
                "src/core/text.js",
                "src/core/countries.js",
                "src/core/valueSynonyms.js",
                "src/core/fieldCatalog.js",
                "src/core/profileAdapter.js",
                "src/core/fieldMatcher.js",
                "src/core/valueFormatter.js",
                "src/dom/fieldDescriptor.js",
                "src/dom/fieldScanner.js",
                "src/dom/fieldFiller.js",
                "src/sites/siteRegistry.js",
                "src/sites/linkedin.js",
                "src/sites/computrabajo.js",
                "src/sites/elempleo.js",
                "src/sites/indeed.js",
                "src/sites/ats.js",
                "src/autofillService.js",
                "src/previewService.js",
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}
