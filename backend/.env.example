# Copia este archivo como .env dentro de backend/ y completa los valores.
# El archivo .env real está ignorado por git y NO debe subirse al repositorio.

# --- Servidor ---
# En local puedes omitir PORT (se usa 3000). En la nube (Render y similares)
# la plataforma define PORT automáticamente; no hace falta fijarlo a mano.
# PORT=3000

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_contraseña
DB_NAME=fillpro_db
DB_PORT=3306
# Conexión cifrada (TLS). Déjalo sin definir o en false para MySQL local.
# Los proveedores de MySQL en la nube (TiDB, Aiven, etc.) la exigen: DB_SSL=true
DB_SSL=false

# --- Autenticación ---
# Clave secreta usada para firmar los tokens JWT. OBLIGATORIA: el servidor no
# arranca sin ella. Usa una cadena larga y aleatoria; no la compartas.
JWT_SECRET=cambia_esta_clave_por_una_secreta_y_larga

# --- CORS ---
# Orígenes permitidos para peticiones del navegador, separados por comas
# (p. ej. la URL del frontend desplegado). Si lo dejas vacío (desarrollo
# local) se permite cualquier origen. Las peticiones de la extensión siempre
# se permiten, tengan o no origen.
# CORS_ORIGINS=https://tu-frontend.ejemplo.com
CORS_ORIGINS=
