# Copia este archivo como .env dentro de backend/ y completa los valores.
# El archivo .env real está ignorado por git y NO debe subirse al repositorio.

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_contraseña
DB_NAME=fillpro_db
DB_PORT=3306

# --- Autenticación ---
# Clave secreta usada para firmar los tokens JWT.
# Usa una cadena larga y aleatoria; no la compartas.
JWT_SECRET=cambia_esta_clave_por_una_secreta_y_larga
